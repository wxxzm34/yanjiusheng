<view class="wrap" wx:if="{{entry}}">
  <view class="h1">{{title}}</view>
  <view wx:if="{{unitNote}}" class="muted">{{unitNote}}</view>
  <view class="muted">{{timeText}} 记下的。时间不动。</view>
  <view class="card">
    <mood-picker label="心情" value="{{mood}}" bind:change="onMood" />
    <view class="note-label">心情感悟</view>
    <textarea class="note" maxlength="80" placeholder="写一句，可以不写" value="{{moodNote}}" bindinput="onNote" auto-height />
  </view>
  <block wx:if="{{entry.kind === 'drink'}}">
    <view class="chips" style="margin-top: 24rpx;">
      <view
        wx:for="{{types}}"
        wx:key="*this"
        class="chip {{drinkType === item ? 'on' : ''}}"
        data-type="{{item}}"
        bindtap="pickType"
      >{{item}}</view>
    </view>
    <input wx:if="{{drinkType === '其他'}}" class="field" placeholder="名字" maxlength="12" value="{{drinkLabel}}" bindinput="onLabel" />
    <input class="field" placeholder="地点" maxlength="24" value="{{location}}" bindinput="onLocation" />
  </block>
  <button class="btn" bindtap="saveEdit">保存</button>
</view>
