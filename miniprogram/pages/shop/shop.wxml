<view class="wrap">
  <view class="h1">装扮</view>
  <view class="muted">下载只存在这台手机里。正在用 {{skin.name}}</view>
  <view class="card" wx:for="{{outfits}}" wx:key="id">
    <view class="preview" style="background: linear-gradient({{item.from}}, {{item.to}}); color: {{item.ink}};">
      <view class="swatch" style="background: {{item.accent}};"></view>
      <view>{{item.name}}</view>
    </view>
    <view class="muted">{{item.blurb}}</view>
    <button class="btn btn-line" data-id="{{item.id}}" bindtap="act">
      {{item.active ? '使用中' : item.unlocked ? '使用' : item.pending ? '下载中…' : '下载'}}
    </button>
  </view>
  <view class="card">
    <view>小本本</view>
    <button class="btn btn-line" bindtap="sample">试试</button>
    <button class="btn btn-line" bindtap="clearAll">清空记录</button>
  </view>
  <tab-bar current="shop" />
</view>
