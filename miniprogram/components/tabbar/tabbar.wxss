.bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  display: flex;
  background: rgba(255, 248, 241, 0.96);
  border-radius: 999rpx;
  padding: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(43, 33, 24, 0.12);
}

.item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  color: #2b2118;
}

.item.on {
  background: #ff5a36;
  color: #fffaf6;
}
