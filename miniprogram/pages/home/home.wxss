.count {
  font-size: 72rpx;
  font-weight: 700;
  margin: 8rpx 0;
}

.link {
  margin-top: 12rpx;
  text-decoration: underline;
}

.log-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.log-row .btn {
  margin-top: 0;
  width: auto;
  line-height: 80rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
}

.log-row .btn::after {
  border: none;
}

.log-row .tap {
  flex: 1;
}

.log-row .record {
  flex: none;
  background: #2b2118;
  color: #fffaf6;
}
