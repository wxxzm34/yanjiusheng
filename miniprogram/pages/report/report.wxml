<view class="wrap">
  <view class="row">
    <view class="h1">报告</view>
    <button size="mini" bindtap="shareCurrent">分享</button>
  </view>
  <view class="chips ranges">
    <view
      wx:for="{{ranges}}"
      wx:key="id"
      class="chip {{range === item.id ? 'on' : ''}}"
      data-range="{{item.id}}"
      bindtap="switchRange"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{range !== 'year'}}" class="chart-card">
    <ec-canvas id="day-chart" canvas-id="day-chart" ec="{{dayEc}}"></ec-canvas>
  </view>
  <block wx:else>
    <view class="chart-card year">
      <ec-canvas id="year-smoke" canvas-id="year-smoke" ec="{{smokeEc}}"></ec-canvas>
    </view>
    <view class="chart-card year">
      <ec-canvas id="year-drink" canvas-id="year-drink" ec="{{drinkEc}}"></ec-canvas>
    </view>
  </block>

  <view class="card summary">{{summaryText}}</view>
  <tab-bar current="report" />
</view>
