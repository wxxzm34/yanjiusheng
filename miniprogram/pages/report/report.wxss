.ranges {
  margin-top: 20rpx;
}

.ranges .chip {
  padding: 12rpx 18rpx;
  font-size: 26rpx;
}

.chart-card {
  margin-top: 24rpx;
  height: 480rpx;
  background: rgba(255, 250, 246, 0.94);
  border-radius: 32rpx;
  overflow: hidden;
}

.chart-card.year {
  height: 420rpx;
}

.chart-card ec-canvas {
  width: 100%;
  height: 100%;
}

.summary {
  font-size: 30rpx;
  line-height: 1.6;
}
