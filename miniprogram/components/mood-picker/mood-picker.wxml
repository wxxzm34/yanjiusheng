<view>
  <view class="label" wx:if="{{label}}">{{label}}</view>
  <view class="chips">
    <view
      wx:for="{{moods}}"
      wx:key="name"
      class="chip {{value === item.name ? 'on' : ''}}"
      data-mood="{{item.name}}"
      bindtap="pick"
    >
      <view class="emoji">{{item.emoji}}</view>
      <view>{{item.name}}</view>
    </view>
  </view>
</view>
