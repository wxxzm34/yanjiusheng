.count {
  font-size: 72rpx;
  font-weight: 700;
  margin: 8rpx 0;
}

.link {
  margin-top: 12rpx;
  text-decoration: underline;
}

.log-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.log-row .btn {
  margin-top: 0;
  width: auto;
  line-height: 80rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
}

.log-row .btn::after {
  border: none;
}

.log-row .tap {
  flex: 1;
}

.log-row .record {
  flex: none;
}

.theme .card,
.theme .btn-line,
.theme .link {
  color: #2b2118;
}

.theme > .muted {
  color: inherit;
  opacity: 0.75;
}

.theme .card .muted {
  color: #7a6558;
  opacity: 1;
}
