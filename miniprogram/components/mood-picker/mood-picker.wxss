.label {
  margin-bottom: 12rpx;
  color: #7a6558;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  box-sizing: border-box;
  width: calc(50% - 6rpx);
  text-align: center;
  padding: 20rpx 8rpx;
  border-radius: 24rpx;
  background: #fff;
  font-size: 26rpx;
  line-height: 1.3;
}

.chip.on {
  background: #ff5a36;
  color: #fffaf6;
}
