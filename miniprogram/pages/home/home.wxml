<view class="wrap theme {{skin.id === 'outfit-wild' ? 'rock' : ''}}" style="background: linear-gradient({{bg.from}}, {{bg.to}}); color: {{skin.ink}};">
  <view class="h1">烟酒生</view>
  <view class="muted">{{greeting}} · 装扮 · {{skin.name}}</view>

  <view class="stage" wx:if="{{gag}}">
    <view class="bubble">{{gagText}}</view>
    <view class="hero" style="background: {{skin.heroBody}};"></view>
    <view class="beam" style="background: {{skin.laser}};"></view>
    <view class="user"></view>
    <view class="skip" bindtap="skipGag">跳过</view>
  </view>

  <view class="pick-row">
    <view class="pick-col">
      <view
        class="choice"
        style="background: {{selected === 'smoke' ? cardOn : cardIdle}}; color: {{skin.ink}};"
        bindtap="selectSmoke"
      >
        <view class="choice-count">{{smokeCount}} 支烟</view>
        <view class="choice-name">记一支</view>
      </view>
      <view class="step-wrap {{selected === 'smoke' ? '' : 'dim'}}" bindtap="selectSmoke">
        <qty-stepper value="{{smokeQty}}" min="0" bind:change="onSmokeQty" />
      </view>
    </view>
    <view class="pick-col">
      <view
        class="choice"
        style="background: {{selected === 'drink' ? cardOn : cardIdle}}; color: {{skin.ink}};"
        bindtap="selectDrink"
      >
        <view class="choice-count">{{drinkCount}} 杯酒</view>
        <view wx:if="{{baijiuMl}}" class="choice-sub">用量 {{baijiuMl}} 毫升</view>
        <view class="choice-name">记一杯</view>
      </view>
      <view class="step-wrap {{selected === 'drink' ? '' : 'dim'}}" bindtap="selectDrink">
        <qty-stepper value="{{drinkQty}}" min="0" bind:change="onDrinkQty" />
      </view>
    </view>
  </view>
  <button class="btn record-wide" style="background: {{skin.accent}}; color: {{skin.onAccent || skin.paper}};" bindtap="record">记录</button>
  <view class="card">
    <mood-picker label="{{linkFresh ? '点一下改刚才记下的心情，下一笔也会带上' : '点一下，下一笔记下时带上'}}" value="{{draftMood}}" bind:change="onMood" />
    <view wx:if="{{linkFresh}}" class="link" bindtap="freezeMood">{{freshCount > 1 ? '刚才这几笔就这样' : '刚才那笔就这样'}}</view>
  </view>

  <view class="card" wx:if="{{today.length === 0}}">
    <view class="h1" style="font-size: 40rpx;">今天还是空白的</view>
    <view class="muted">先选烟或酒，再点记录。</view>
    <button class="btn btn-line" bindtap="loadSample">试试示例</button>
  </view>

  <view class="card" wx:else>
    <view class="row" wx:for="{{today}}" wx:key="id">
      <text>{{item.timeText}} · {{item.title}}</text>
      <text>{{item.moodText}}</text>
    </view>
  </view>
  <button class="btn btn-line" bindtap="shareToday">分享今天</button>
  <tab-bar current="home" />
</view>
