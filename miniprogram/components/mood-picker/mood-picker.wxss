.label {
  margin-bottom: 12rpx;
  color: #7a6558;
}

.chips {
  display: flex;
  gap: 12rpx;
}

.chip {
  flex: 1;
  text-align: center;
  padding: 16rpx 0 18rpx;
  border-radius: 24rpx;
  background: #fff;
  color: #2b2118;
}

.emoji {
  font-size: 40rpx;
  line-height: 1.2;
}

.chip.on {
  background: #ff5a36;
  color: #fffaf6;
}
