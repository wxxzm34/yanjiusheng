.ranges {
  margin-top: 20rpx;
}

.ranges .chip {
  padding: 12rpx 18rpx;
  font-size: 26rpx;
}

.chart-card {
  margin-top: 24rpx;
  height: 480rpx;
  background: rgba(255, 250, 246, 0.94);
  border-radius: 32rpx;
  overflow: hidden;
}

.chart-card.year {
  height: 420rpx;
}

.chart-card ec-canvas {
  width: 100%;
  height: 100%;
}

.summary {
  font-size: 30rpx;
  line-height: 1.6;
}

.mood-bar {
  display: flex;
  height: 28rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
}

.mood-seg {
  min-width: 8rpx;
  height: 100%;
}

.mood-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
  margin-top: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
}

.swatch {
  width: 20rpx;
  height: 20rpx;
  border-radius: 999rpx;
}
